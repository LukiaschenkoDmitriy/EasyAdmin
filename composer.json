{
    "name": "easy-admin/core",
    "description": "Symfony Admin Builder",
    "license": "MIT",
    "require": {
        "symfony/dependency-injection": "^8.1",
        "doctrine/orm": "^3.7.2",
        "symfony/http-foundation": "^8.1",
        "symfony/http-kernel": "^8.1",
        "symfony/config": "^8.1",
        "symfony/routing": "^8.1",
        "twig/twig": "^3.0",
        "symfony/asset-mapper": "^8.1",
        "symfony/framework-bundle": "^8.1",
        "symfony/twig-bundle": "^8.1",
        "symfony/console": "^8.1",
        "symfony/process": "^8.1",
        "symfony/yaml": "^8.1",
        "friendsofsymfony/elastica-bundle": "^7.2"
    },
    "autoload": {
        "psr-4": {
            "EAdmin\\Core\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "EAdmin\\Core\\Tests\\": "tests/"
        }
    },
    "authors": [
        {
            "name": "Dmytrii Lukiashchenko",
            "email": "dmytrii.lukiashchenko@gmail.com"
        }
    ],
    "require-dev": {
        "phpunit/phpunit": "^13.2",
        "symfony/maker-bundle": "^1.67"
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": true
        }
    }
}
