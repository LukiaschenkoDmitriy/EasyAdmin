<input
    type="{{ props.type.value }}"
    {% if props.id %}id="{{ props.id }}"{% endif %}
    {% if props.name %}name="{{ props.name }}"{% endif %}
    {% if props.value is not null %}value="{{ props.value }}"{% endif %}
    {% if props.placeholder %}placeholder="{{ props.placeholder }}"{% endif %}

    {% if props.required %}required{% endif %}
    {% if props.disabled %}disabled{% endif %}
    {% if props.readonly %}readonly{% endif %}
    {% if props.autofocus %}autofocus{% endif %}
    {% if props.checked %}checked{% endif %}
    {% if props.multiple %}multiple{% endif %}

    {% if props.minlength is not null %}minlength="{{ props.minlength }}"{% endif %}
    {% if props.maxlength is not null %}maxlength="{{ props.maxlength }}"{% endif %}
    {% if props.min is not null %}min="{{ props.min }}"{% endif %}
    {% if props.max is not null %}max="{{ props.max }}"{% endif %}
    {% if props.step %}step="{{ props.step }}"{% endif %}
    {% if props.pattern %}pattern="{{ props.pattern }}"{% endif %}

    {% if props.autocomplete %}autocomplete="{{ props.autocomplete }}"{% endif %}
    {% if props.accept %}accept="{{ props.accept }}"{% endif %}

    {% if props.tabindex is not null %}tabindex="{{ props.tabindex }}"{% endif %}
    {% if props.title %}title="{{ props.title }}"{% endif %}
    {% if props.ariaLabel %}aria-label="{{ props.ariaLabel }}"{% endif %}
    {% if props.ariaDescribedby %}aria-describedby="{{ props.ariaDescribedby }}"{% endif %}
    {% if props.form %}form="{{ props.form }}"{% endif %}

    {% for key, val in props.data %}data-{{ key }}="{{ val }}" {% endfor %}

    class="eadmin-input{% if props.class %} {{ props.class }}{% endif %}"
>