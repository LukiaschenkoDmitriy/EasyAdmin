{% macro base_attribute(props) %}
    {% if props.id %}id="{{ props.id }}"{% endif %}
    {% if props.class %}class="{{ props.class }}"{% endif %}
    {% if props.style %}style="{{ props.style }}"{% endif %}
    {% if props.title %}title="{{ props.title }}"{% endif %}
    {% if props.tabindex is not null %}tabindex="{{ props.tabindex }}"{% endif %}
    {% if props.lang %}lang="{{ props.lang }}"{% endif %}
    {% if props.dir %}dir="{{ props.dir }}"{% endif %}
    {% if props.role %}role="{{ props.role }}"{% endif %}

    {% if props.hidden %}hidden{% endif %}
    {% if props.draggable is not null %}draggable="{{ props.draggable ? 'true' : 'false' }}"{% endif %}
    {% if props.contenteditable is not null %}contenteditable="{{ props.contenteditable ? 'true' : 'false' }}"{% endif %}
    {% if props.spellcheck is not null %}spellcheck="{{ props.spellcheck ? 'true' : 'false' }}"{% endif %}

    {% if props.ariaLabel %}aria-label="{{ props.ariaLabel }}"{% endif %}
    {% if props.ariaLabelledby %}aria-labelledby="{{ props.ariaLabelledby }}"{% endif %}
    {% if props.ariaDescribedby %}aria-describedby="{{ props.ariaDescribedby }}"{% endif %}
    {% if props.ariaHidden %}aria-hidden="{{ props.ariaHidden }}"{% endif %}

    {% for key, val in props.data %}data-{{ key }}="{{ val }}" {% endfor %}
    {% for key, val in props.aria %}aria-{{ key }}="{{ val }}" {% endfor %}
{% endmacro %}